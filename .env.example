# Copy this file to .env (same folder as main.py) and fill in your own values.
# Never commit the real .env file to git - that's why this template exists.

# Supabase project URL: Project Settings > API > Project URL
SUPABASE_URL=

# Project Settings > API > Project API keys > "anon" "public" key.
# This is the public key (the same one a frontend app uses); access is still
# limited by each user's own token and Row Level Security. Never put the
# "service_role" key here.
SUPABASE_ANON_KEY=
